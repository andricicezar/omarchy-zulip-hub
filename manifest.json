{
  "schemaVersion": 1,
  "id": "io.github.valentin-briez-banuls.zulip-hub",
  "name": "Zulip Hub",
  "version": "2.10.0",
  "author": "Valentin Briez-Banuls",
  "license": "MIT",
  "description": "Zulip messages, notifications, and direct replies integrated into Omarchy.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "plugin/Panel.qml",
    "service": "plugin/Service.qml"
  },
  "barWidget": {
    "displayName": "Zulip Hub",
    "description": "Read and send Zulip messages from the Omarchy bar.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showTotal": true,
      "showMentions": true,
      "hideWhenEmpty": false,
      "refreshIntervalSec": 2
    },
    "schema": [
      {
        "key": "showTotal",
        "type": "boolean",
        "label": "Show total unread count",
        "defaultValue": true
      },
      {
        "key": "showMentions",
        "type": "boolean",
        "label": "Highlight mentions",
        "defaultValue": true
      },
      {
        "key": "hideWhenEmpty",
        "type": "boolean",
        "label": "Hide when there are no unread messages",
        "defaultValue": false
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Fallback refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
